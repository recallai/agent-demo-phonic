# Keep the Recall key and URL in the same workspace and region.
RECALL_API_KEY=
RECALL_API_BASE_URL=https://us-east-1.recall.ai/api/v1

# Tunnel only the tool server on port 7866, not the launcher on port 8006.
PHONIC_TOOLS_ORIGIN=

# Used only by the setup command to create/update the five saved webhook tools.
# Save a Phonic key with access to this project in Recall > Agents > Phonic too.
PHONIC_API_KEY=
PHONIC_PROJECT=main
PHONIC_VOICE_ID=sabrina

# Starts when the launcher requests the bot; 60 to 3600 seconds.
SESSION_TIMEOUT_SECONDS=600
